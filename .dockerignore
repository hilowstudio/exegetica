# Keep the Fly/Docker build context lean and secret-free. The image only needs
# pyproject/README/NOTICE/LICENSE, src/, webapp/, docs/, and resource-generators.yaml
# (see Dockerfile). The SQLite DBs are fetched from R2 at runtime, NOT baked in.
# Everything else is excluded so it is never uploaded to the builder.

# Local DB working copies (3+ GB) + ingestion caches + source EPUBs — fetched/derived,
# never shipped in the image. (These live in the repo root during ingestion work.)
db/
.seed_cache/
*.epub

# Virtualenv, VCS, caches
.venv/
.git/
.claude/
**/__pycache__/
*.pyc

# Secrets & local env — must never enter the build context
.env
.secrets/

# Confidential / copyrighted — never ship off this machine
student_profiles/
sproul-transcripts/
ferguson-transcripts/
.firecrawl/

# Large content trees the image does not use
quill-standards/
standards/
data/
_backups/
scripts/
# ...except the house-cover renderer, which the web app runs (see Dockerfile)
!scripts/house_covers.py
!scripts/cover_text.py
!scripts/generate_motifs.py
tests/
# Safety-review transcripts and probe records (scripts/predeploy.py reads them locally)
evals/
# NOTE: docs/ is intentionally NOT ignored — the /course and /calendar views
# read the John lessons, materials, and calendar JSON from docs/ at runtime.

# Brand source images and stray PDFs the image does not use
assets/brand/
*.pdf
