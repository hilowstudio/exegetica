# Study Bible web app — environment variables. Copy to .env and fill in.

# Required to use the built-in Anthropic key for chat/generation (users can also
# bring their own key in the browser).
ANTHROPIC_API_KEY=

# Optional. Enables live ESV text via the Crossway API (also read as ESV_API_KEY).
BIBLE_API_KEY=

# Optional. Living Library book search works without this (OpenLibrary, keyless).
# A Google Books API key adds richer covers/metadata and raises the rate limit.
# Get one at https://console.cloud.google.com (enable the Books API).
GOOGLE_BOOKS_API_KEY=

# Optional. Media Studio (/studio, the library admin login only). Each key turns on that
# service, and each model runs on the cheapest service that is set up. The studio also needs
# R2. See docs/decisions/0017-image-studio.md.
FAL_API_KEY=
RUNWARE_API_KEY=
WAVESPEED_API_KEY=
REPLICATE_API_TOKEN=
# The maker's own GPU: ComfyUI on Baseten (baseten/README.md). Both are needed.
BASETEN_API_KEY=
BASETEN_COMFY_MODEL_ID=
